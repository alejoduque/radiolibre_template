# /etc/systemd/system/ergo.service — the #radiolibre chat
[Unit]
Description=Ergo IRC (iScream chat, #radiolibre)
After=network.target

[Service]
Type=notify
User=ergo
Group=ergo
WorkingDirectory=/var/lib/ergo
ExecStart=/opt/ergo/ergo run --conf /var/lib/ergo/ircd.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
LimitNOFILE=1048576

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ergo

[Install]
WantedBy=multi-user.target
