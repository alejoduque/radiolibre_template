# /etc/systemd/system/matterbridge.service — optional; enable only once
# /etc/matterbridge/matterbridge.toml has real credentials.
[Unit]
Description=matterbridge (#radiolibre ↔ Libera ↔ Telegram)
After=network-online.target ergo.service
Wants=network-online.target

[Service]
User=matterbridge
Group=matterbridge
ExecStart=/opt/matterbridge/matterbridge -conf /etc/matterbridge/matterbridge.toml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
