# /etc/matterbridge/matterbridge.toml — root:matterbridge, mode 640. NEVER commit
# the real one: it holds the Libera password and the Telegram bot token.
#
# Mirrors #radiolibre between our Ergo, Libera.Chat and a Telegram group.
# Remove any [section] and its [[gateway.inout]] you don't want bridged.
#
# Once this runs, set CHAT_BRIDGED=1 in /etc/iscream/iscream.env and restart
# iscream: the page then warns that chat messages also land on those networks.

[general]
RemoteNickFormat = "<{NICK}> "

# Our Ergo, over loopback (plaintext is fine: it never leaves the machine).
[irc.ergo]
Server = "127.0.0.1:6667"
Nick = "puente"
RemoteNickFormat = "[{PROTOCOL}] <{NICK}> "

# Libera.Chat — register the bot nick once with NickServ, then use SASL.
[irc.libera]
Server = "irc.libera.chat:6697"
UseTLS = true
UseSASL = true
Nick = "radiolibre-puente"
NickServNick = "radiolibre-puente"
NickServPassword = "CAMBIAR"
RemoteNickFormat = "[iScream] <{NICK}> "

# Telegram — create a bot with @BotFather, add it to the group, and turn off
# its privacy mode (/setprivacy → Disable) so it can read the group.
# The chat id of a group is negative, e.g. -1001234567890.
[telegram.radiolibre]
Token = "CAMBIAR"
MessageFormat = "HTMLNick"
RemoteNickFormat = "<{NICK}> "

[[gateway]]
name = "radiolibre"
enable = true

    [[gateway.inout]]
    account = "irc.ergo"
    channel = "#radiolibre"

    [[gateway.inout]]
    account = "irc.libera"
    channel = "#radiolibre"

    [[gateway.inout]]
    account = "telegram.radiolibre"
    channel = "-100CAMBIAR"
