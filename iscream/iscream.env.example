# /etc/iscream/iscream.env — owned by root, mode 600. Never commit the real one.

# Where the page is served; nginx proxies reporta.altred.xyz to this.
PORT=3000
BIND=127.0.0.1

# Icecast source credentials. Leave the password empty for a dry run
# (ffmpeg decodes the audio and throws it away).
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
ICECAST_MOUNT=/reporta.mp3
# People on air at once. Mounts: /reporta.mp3, /reporta2.mp3 … /reportaN.mp3;
# each needs a <mount> block in icecast.xml with the same password.
ICECAST_SLOTS=8
ICECAST_SOURCE_PASSWORD=

MP3_BITRATE=128k

# Set to 1 once matterbridge links #radiolibre to Libera/Telegram, so the page
# warns that chat messages leave this server.
CHAT_BRIDGED=0

# 1 logs ffmpeg's stderr (with the password masked).
DEBUG=0
